            print("WAKE_WORD_DETECTED", flush=True)
            cooldown = time.time() + 1.5  # Short cooldown so interrupt works quickly
except KeyboardInterrupt:
    print("Stopping...")
finally:
    recorder.stop()
    recorder.delete()
    porcupine.delete()
